#!/usr/bin/env bash
# music-health-watch - every 5 min (timer). Alerts when a music container is missing/stopped/unhealthy
# on TWO consecutive runs (so a deploy's ~30s restart never pages). Skips while deploy.sh holds a lock.
set -uo pipefail
CONTAINERS=${MUSIC_WATCH_CONTAINERS:-"music-backend music-frontend music-backend-prod music-frontend-prod cloudflared-marcus"}
STATE=${MUSIC_WATCH_STATE:-/var/lib/music-deploy/health-watch}; LOCKS=${MUSIC_DEPLOY_STATE:-/var/lib/music-deploy}
ALERT=${MUSIC_ALERT_BIN:-/usr/local/bin/music-alert}
install -d -m 700 "$STATE"
STALE_MIN=${MUSIC_WATCH_STALE_MIN:-30}
# deploying(env): 0 if a deploy of that env holds its lock (and has for < STALE_MIN), else 1.
# A lock held longer than STALE_MIN is a stuck deploy: alert, and do NOT mute that env's containers.
deploying() {
  local l="$LOCKS/$1.lock" age; [ -e "$l" ] || return 1
  exec 8<"$l"; if flock -n 8; then flock -u 8; exec 8<&-; return 1; fi; exec 8<&-
  age=$(( ( $(date +%s) - $(stat -c %Y "$l") ) / 60 ))
  if [ "$age" -ge "$STALE_MIN" ]; then
    MUSIC_ALERT_TTL="15 minutes" "$ALERT" MusicDeployStuck warning "music-deploy $1 has held its lock for ${age} min" "Check: ps aux | grep music-deploy; music-deploy $1 --status" env="$1"
    return 1
  fi
  return 0
}
env_of() { case $1 in *-prod|cloudflared-marcus) echo prod;; *) echo dev;; esac; }
for c in $CONTAINERS; do
  if deploying "$(env_of "$c")"; then echo "$c: deploy of $(env_of "$c") in progress; skipping this container"; continue; fi
  s=$(docker inspect -f '{{.State.Status}}/{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' "$c" 2>/dev/null) || s=missing/none
  case $s in running/healthy|running/none|running/starting) rm -f "$STATE/$c.bad"; continue;; esac
  if [ -f "$STATE/$c.bad" ]; then
    case $c in *-prod|cloudflared-marcus) sev=critical;; *) sev=warning;; esac
    MUSIC_ALERT_TTL="15 minutes" "$ALERT" MusicContainerUnhealthy "$sev" "music container $c is $s" "Seen on 2 consecutive checks. Check: docker ps -a; docker logs --tail 50 $c" container="$c"
  else echo "$c is $s (first sighting; will alert if still bad next run)"; touch "$STATE/$c.bad"; fi
done
